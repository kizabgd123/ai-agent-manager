# Groq / Gemini
GROQ_API_KEY=
GEMINI_API_KEY=

# MongoDB driver configuration. Create a text index on papers.title,
# papers.abstract, and papers.keywords to enable MongoDBTool.search_papers().
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DATABASE=research_assistant
MONGODB_COLLECTION=papers
# Use these only when credentials are not embedded in MONGODB_URI.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# AnythingLLM app
APP_PASSWORD=
JWT_SECRET=

# Validation/runtime helpers
VERCEL_URL=https://<your-project>.vercel.app
SPACE_URL=https://<your-space>.hf.space
SPACE_TOKEN=
